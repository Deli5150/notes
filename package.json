{
  "name": "notes",
  "version": "1.0.0",
  "description": "Notes — a notes app inspired by Apple Notes, for macOS and Windows",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": "github:Deli5150/notes",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "desktop": "node scripts/desktop.mjs && cd desktop && npx electron .",
    "dist:desktop": "node scripts/desktop.mjs --mac --win",
    "release": "node scripts/release.mjs",
    "icons": "desktop/node_modules/.bin/electron scripts/render-icons.cjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-subscript": "^3.35.0",
    "@tiptap/extension-superscript": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/extension-typography": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.5",
    "unpdf": "^2.2.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
