{
  "name": "notes",
  "productName": "Notes",
  "version": "1.0.2",
  "description": "Notes for your thoughts, lists and pictures",
  "author": "Deli5150",
  "license": "MIT",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.notes.desktop",
    "productName": "Notes",
    "copyright": "Copyright © 2026 Notes",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "google.cjs",
      "ai.cjs",
      "google.json",
      "web/**",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "bin/notes-titles",
          "to": "notes-titles"
        }
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac.${ext}",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Notes reads your Apple Notes when you import them.",
        "NSMicrophoneUsageDescription": "Notes records audio into your notes.",
        "NSCameraUsageDescription": "Notes scans documents and takes photos for your notes."
      }
    },
    "dmg": {
      "title": "Delta Notes ${version}",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notes",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "synopsis": "Notes for your thoughts, lists and pictures",
      "description": "A notes app inspired by Apple Notes, with Google sync.",
      "desktop": {
        "entry": {
          "StartupWMClass": "Notes"
        }
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": null,
    "electronLanguages": [
      "en",
      "en-US",
      "en-GB"
    ]
  },
  "allowScripts": {
    "electron@45.0.0": true
  }
}
